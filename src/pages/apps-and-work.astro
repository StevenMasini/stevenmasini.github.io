---
import BaseLayout from '../layouts/BaseLayout.astro';
import StatsGrid from '../components/StatsGrid.astro';
import SectionHeader from '../components/SectionHeader.astro';
import FlagshipProjectCard from '../components/FlagshipProjectCard.astro';
import SpotlightProjectCard from '../components/SpotlightProjectCard.astro';
import AgencyAppRow from '../components/AgencyAppRow.astro';
import FoundationCard from '../components/FoundationCard.astro';
import {
  workPageStats,
  flagshipProjects,
  spotlightProjects,
  agencyProjects,
  earlyFoundations,
} from '../data/portfolio';
---

<BaseLayout
  title="Apps & Shipped Work — Steven Masini"
  description="A documented record of native iOS applications, performance turnarounds, and client infrastructure shipped to millions of users worldwide."
  activeNav="apps-and-work"
>
  <div class="max-w-6xl mx-auto px-6 sm:px-8 py-16 md:py-20 flex flex-col gap-20">
    <!-- Hero Section -->
    <section class="flex flex-col gap-4 border-b border-neutral-200 pb-12">
      <div
        class="flex items-center gap-2 text-xs font-mono text-neutral-400 tracking-wider uppercase"
      >
        <span>Portfolio</span>
        <span>•</span>
        <span>15+ Years Shipped Native Software</span>
      </div>
      <h1
        class="text-3xl sm:text-4xl lg:text-5xl font-semibold tracking-tight text-neutral-950"
      >
        Apps &amp; Shipped Work
      </h1>
      <p
        class="text-base sm:text-lg text-neutral-600 font-normal leading-relaxed max-w-2xl mt-1"
      >
        A documented record of native iOS applications, performance turnarounds,
        and client infrastructure shipped to millions of users worldwide.
      </p>

      <StatsGrid stats={workPageStats} variant="compact" />
    </section>

    <!-- 01 / Flagship Productions -->
    <section class="flex flex-col gap-14">
      <SectionHeader
        title="01 / Flagship Productions"
        rightLabel="Deep-Dive Architectures"
      />

      {
        flagshipProjects.map((project) => (
          <FlagshipProjectCard project={project} />
        ))
      }

      <!-- Spotlight Projects (CURIO EYE & Talkmate) -->
      <div
        class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 pb-14 border-b border-neutral-200"
      >
        {
          spotlightProjects.map((project) => (
            <SpotlightProjectCard project={project} />
          ))
        }
      </div>
    </section>

    <!-- 02 / Earlier Work & Agency Era -->
    <section class="flex flex-col gap-10">
      <SectionHeader
        title="02 / Earlier Work & Agency Era"
        rightLabel="Paris (userADgents) & Foundations"
      />

      <div class="flex flex-col gap-8">
        <div>
          <h3 class="text-sm font-semibold text-neutral-900 mb-3">
            Press, Media &amp; High-Volume Commercial Apps (2012 – 2014)
          </h3>
          <div class="border border-neutral-200 rounded overflow-hidden bg-white">
            <div class="divide-y divide-neutral-200">
              {
                agencyProjects.map((project) => (
                  <AgencyAppRow project={project} />
                ))
              }
            </div>
          </div>
        </div>

        <div>
          <h3 class="text-sm font-semibold text-neutral-900 mb-3">
            Early Technical Foundations (2011 – 2012)
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            {earlyFoundations.map((item) => <FoundationCard item={item} />)}
          </div>
        </div>
      </div>
    </section>

    <!-- Bottom Callout CTA -->
    <section class="border-t border-neutral-200 pt-12 pb-4">
      <div
        class="flex flex-col md:flex-row md:items-baseline justify-between gap-6"
      >
        <div class="flex flex-col gap-2 max-w-lg">
          <span
            class="text-xs font-mono uppercase tracking-widest text-neutral-400"
          >
            Available For Hire
          </span>
          <h3 class="text-2xl font-semibold text-neutral-950 tracking-tight">
            Need native iOS engineering support?
          </h3>
          <p class="text-sm text-neutral-600 leading-relaxed">
            Available for contract roles, performance diagnostics, and
            greenfield app releases. Direct communication, clean Git history,
            zero bloat.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-3">
          <a
            class="px-5 py-2.5 bg-neutral-900 text-white rounded text-xs font-mono font-medium hover:bg-neutral-800 transition-colors"
            href="/contact"
          >
            Get in Touch →
          </a>
          <a
            class="px-4 py-2.5 border border-neutral-300 rounded text-xs font-mono text-neutral-700 hover:text-neutral-950 hover:border-neutral-900 transition-colors"
            href="/experience"
          >
            View Experience Bio →
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
