---
import BaseLayout from '../layouts/BaseLayout.astro';
import StatsGrid from '../components/StatsGrid.astro';
import TimelineItem from '../components/TimelineItem.astro';
import {
  experiencePageStats,
  experienceTimeline,
  educationList,
  technicalFocusList,
  languagesList,
} from '../data/portfolio';
---

<BaseLayout
  title="Experience & Background — Steven Masini"
  description="Developing software & native iOS applications since 2011. 15+ years across Paris, Beijing, and Taipei."
  activeNav="experience"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-8 py-12 md:py-16">
    <!-- Header Section -->
    <section class="border-b border-neutral-200 pb-12 mb-12">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div class="max-w-2xl">
          <div
            class="font-mono text-xs text-neutral-500 uppercase tracking-wider mb-2"
          >
            Resume &amp; Work History
          </div>
          <h1
            class="text-3xl sm:text-4xl font-semibold tracking-tight text-neutral-900 mb-3"
          >
            Experience &amp; Background
          </h1>
          <p class="text-base text-neutral-600 leading-relaxed font-normal">
            Developing software &amp; native iOS applications since 2011. 15+
            years across Paris, Beijing, and Taipei. From fundamental Unix and C
            systems to native iOS architecture, companion Node.js backend
            infrastructure, and modern AI workflows.
          </p>
        </div>

        <div
          class="flex flex-col sm:flex-row md:flex-col items-start md:items-end gap-2 shrink-0"
        >
          <button
            type="button"
            onclick="window.print()"
            class="inline-flex items-center gap-2 px-4 py-2 border border-neutral-200 bg-white hover:bg-neutral-50 rounded text-xs font-medium text-neutral-900 transition-colors cursor-pointer"
          >
            <span class="material-symbols-outlined text-base text-neutral-500">
              description
            </span>
            Download PDF Resume
          </button>
          <a
            class="inline-flex items-center gap-1 font-mono text-xs text-neutral-500 hover:text-neutral-900 transition-colors underline"
            href="/contact"
          >
            <span class="material-symbols-outlined text-[14px]">mail</span>
            Contact Form →
          </a>
        </div>
      </div>

      <StatsGrid stats={experiencePageStats} variant="detailed" />
    </section>

    <!-- Content Grid: 8 Cols Experience, 4 Cols Education & Toolkit -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      <!-- Left: Chronological Resume Timeline -->
      <div class="lg:col-span-8 flex flex-col gap-10">
        <div
          class="flex items-center justify-between border-b border-neutral-200 pb-3"
        >
          <h2
            class="text-sm font-semibold uppercase tracking-wider font-mono text-neutral-900"
          >
            Work History
          </h2>
          <span class="font-mono text-xs text-neutral-500">2011 — Present</span>
        </div>

        <div class="space-y-12">
          {experienceTimeline.map((item) => <TimelineItem item={item} />)}
        </div>
      </div>

      <!-- Right: Calm Education & Toolkit Sidebar -->
      <div class="lg:col-span-4 flex flex-col gap-10">
        <!-- Education Section -->
        <section class="border-b border-neutral-200 pb-8 space-y-6">
          <div class="flex items-center justify-between">
            <h2
              class="text-sm font-semibold uppercase tracking-wider font-mono text-neutral-900"
            >
              Education
            </h2>
          </div>

          <div class="space-y-6">
            {
              educationList.map((edu, idx) => (
                <div
                  class:list={[
                    idx > 0 && 'pt-4 border-t border-neutral-200/60',
                  ]}
                >
                  <div class="flex items-baseline justify-between">
                    <h3 class="text-sm font-semibold text-neutral-900">
                      {edu.institution}
                    </h3>
                    <span class="text-xs font-mono text-neutral-500">
                      {edu.period}
                    </span>
                  </div>
                  <div class="text-xs text-neutral-600 font-medium mt-0.5">
                    {edu.subtitle}
                  </div>
                  {edu.degree && (
                    <div class="text-xs font-mono text-neutral-500 mt-1">
                      {edu.degree}
                    </div>
                  )}
                  <p class="text-xs text-neutral-600 mt-1.5 leading-relaxed">
                    {edu.description}
                  </p>
                </div>
              ))
            }

            <div class="pt-4 border-t border-neutral-200/60">
              <div class="text-xs font-medium text-neutral-900">
                CHINICT Beijing Hackathon Award
              </div>
              <div class="text-xs font-mono text-neutral-500">
                Winner • 2012 Annual Tech Summit
              </div>
            </div>
          </div>
        </section>

        <!-- Technical Focus -->
        <section class="border-b border-neutral-200 pb-8 space-y-4">
          <h2
            class="text-sm font-semibold uppercase tracking-wider font-mono text-neutral-900"
          >
            Technical Focus
          </h2>
          <div class="space-y-4 text-xs">
            {
              technicalFocusList.map((focus) => (
                <div>
                  <div class="font-mono text-neutral-500 mb-1.5 uppercase text-[11px]">
                    {focus.category}
                  </div>
                  <div class="text-neutral-600 leading-relaxed">
                    {focus.skills}
                  </div>
                </div>
              ))
            }
          </div>
        </section>

        <!-- Languages Section -->
        <section class="border-b border-neutral-200 pb-8 space-y-4">
          <h2
            class="text-sm font-semibold uppercase tracking-wider font-mono text-neutral-900"
          >
            Languages
          </h2>
          <div class="space-y-2.5 text-xs">
            {
              languagesList.map((item, idx) => (
                <div
                  class:list={[
                    'flex flex-wrap items-baseline justify-between gap-x-3 gap-y-0.5 py-1.5',
                    idx < languagesList.length - 1 &&
                      'border-b border-neutral-200/60',
                  ]}
                >
                  <span class="font-medium text-neutral-900">
                    {item.language}
                  </span>
                  <span class="text-neutral-500 font-mono text-[11px]">
                    {item.proficiency}
                  </span>
                </div>
              ))
            }
          </div>
        </section>

        <!-- Direct Contact Note -->
        <section class="p-5 border border-neutral-200 bg-white rounded space-y-2">
          <div
            class="font-mono text-[11px] uppercase tracking-wider text-neutral-500"
          >
            Inquiries
          </div>
          <div class="text-xs text-neutral-600 leading-relaxed">
            Open for selective contract work, mobile architecture audits, or
            advisory engagements.
          </div>
          <a
            class="inline-flex items-center gap-1 text-xs font-mono font-medium text-neutral-900 underline hover:text-black pt-1"
            href="/contact"
          >
            Get in touch via Contact Form →
          </a>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>
