---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPortfolioData } from '../data/portfolio';
import { defaultLocale, localeConfigs, locales } from '../data/locales';
import { pagePath } from '../data/pages';

// GitHub Pages serves this single English page for every missing URL, so the
// copy for every Locale is embedded and swapped in client-side.
const copyByLocale = Object.fromEntries(
  locales.map((lang) => [
    lang,
    {
      ...getPortfolioData(lang).ui.notFound,
      htmlLang: localeConfigs[lang].htmlLang,
      homeHref: pagePath('overview', lang),
      appsHref: pagePath('apps-and-work', lang),
      contactHref: pagePath('contact', lang),
    },
  ])
);
const t = copyByLocale[defaultLocale];
---

<BaseLayout title={t.metaTitle} description={t.metaDescription} lang={defaultLocale}>
  <div
    class="max-w-6xl mx-auto px-4 sm:px-8 py-20 sm:py-28 md:py-36 flex flex-col items-start gap-6"
  >
    <div
      class="inline-flex items-center gap-2 px-2.5 py-1 bg-neutral-100 border border-neutral-200 rounded text-xs font-mono text-neutral-600 uppercase tracking-wider"
    >
      <span data-copy="eyebrow">{t.eyebrow}</span>
    </div>

    <div class="flex flex-col gap-3 max-w-xl">
      <h1
        data-copy="title"
        class="type-page-title text-neutral-900"
      >
        {t.title}
      </h1>
      <p data-copy="description" class="text-base text-neutral-600 leading-relaxed">
        {t.description}
      </p>
    </div>

    <div class="flex flex-wrap items-center gap-3 pt-2">
      <a
        data-href="homeHref"
        href={t.homeHref}
        class="inline-flex items-center gap-1.5 bg-neutral-900 hover:bg-neutral-800 text-white text-xs font-mono font-medium px-4 py-2.5 rounded transition-colors"
      >
        <span data-copy="homeLink">{t.homeLink}</span>
        <span class="material-symbols-outlined text-xs">arrow_forward</span>
      </a>
      <a
        data-href="appsHref"
        href={t.appsHref}
        class="inline-flex items-center gap-1.5 border border-neutral-300 bg-white hover:border-neutral-900 text-neutral-700 hover:text-neutral-950 text-xs font-mono px-4 py-2.5 rounded transition-colors"
      >
        <span data-copy="appsLink">{t.appsLink}</span>
      </a>
      <a
        data-href="contactHref"
        href={t.contactHref}
        class="inline-flex items-center gap-1.5 border border-neutral-300 bg-white hover:border-neutral-900 text-neutral-700 hover:text-neutral-950 text-xs font-mono px-4 py-2.5 rounded transition-colors"
      >
        <span data-copy="contactLink">{t.contactLink}</span>
      </a>
    </div>
  </div>

  <script
    id="not-found-copy"
    type="application/json"
    set:html={JSON.stringify(copyByLocale)}
  />

  <script>
    import {
      defaultLocale,
      getPreferredLocale,
      parseLocalizedPath,
    } from '../data/locales';

    // Locale from the URL prefix; on an unprefixed URL, fall back to the
    // visitor's saved language choice.
    const fromPath = parseLocalizedPath(window.location.pathname).lang;
    const lang =
      fromPath !== defaultLocale ? fromPath : (getPreferredLocale() ?? defaultLocale);

    const copyEl = document.getElementById('not-found-copy');
    const copy = copyEl ? JSON.parse(copyEl.textContent ?? '{}')[lang] : undefined;

    if (lang !== defaultLocale && copy) {
      document.documentElement.lang = copy.htmlLang;
      document.title = copy.metaTitle;
      document.querySelectorAll<HTMLElement>('[data-copy]').forEach((el) => {
        el.textContent = copy[el.dataset.copy!] ?? el.textContent;
      });
      document.querySelectorAll<HTMLAnchorElement>('[data-href]').forEach((el) => {
        el.href = copy[el.dataset.href!] ?? el.href;
      });
    }
  </script>
</BaseLayout>
