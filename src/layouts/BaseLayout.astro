---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import {
  defaultLocale,
  getLocalizedPath,
  getPortfolioData,
  localeConfigs,
  locales,
  type Locale,
  type NavItem,
} from '../data/portfolio';

interface Props {
  title?: string;
  description?: string;
  activeNav: NavItem['id'];
  lang?: Locale;
}

const {
  activeNav,
  lang = defaultLocale,
  title: propTitle,
  description: propDescription,
} = Astro.props;

const data = getPortfolioData(lang);
const { siteMetadata, localeInfo, ui } = data;

const title = propTitle ?? ui.overview.metaTitle;
const description = propDescription ?? ui.overview.metaDescription;

const pageSlugMap: Record<NavItem['id'], string> = {
  overview: '/',
  'apps-and-work': '/apps-and-work/',
  experience: '/experience/',
  contact: '/contact/',
};
const rawPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const strippedPath =
  rawPath.replace(/^\/(fr|zh-tw)(?=\/|$)/, '') || pageSlugMap[activeNav] || '/';
const currentSlug = strippedPath.endsWith('/')
  ? strippedPath
  : `${strippedPath}/`;

const canonicalUrl = new URL(
  Astro.url.pathname,
  Astro.site ?? siteMetadata.siteUrl
).toString();
const ogImageUrl = new URL(
  '/og-image.png',
  Astro.site ?? siteMetadata.siteUrl
).toString();

const alternateLinks = locales.map((loc) => ({
  hreflang: localeConfigs[loc].htmlLang,
  href: new URL(
    getLocalizedPath(loc, currentSlug),
    Astro.site ?? siteMetadata.siteUrl
  ).toString(),
}));

const defaultHref = new URL(
  getLocalizedPath(defaultLocale, currentSlug),
  Astro.site ?? siteMetadata.siteUrl
).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${siteMetadata.siteUrl}/#person`,
      name: siteMetadata.name,
      jobTitle: siteMetadata.jobTitleSchema,
      description,
      url: siteMetadata.siteUrl,
      sameAs: [siteMetadata.linkedinUrl, siteMetadata.githubUrl],
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Taipei',
        addressCountry: 'TW',
      },
      alumniOf: [
        {
          '@type': 'CollegeOrUniversity',
          name: 'EPITECH - European Institute of Technology',
        },
        {
          '@type': 'CollegeOrUniversity',
          name: 'Beijing Jiaotong University',
        },
      ],
      knowsLanguage: ['fr', 'en', 'zh', 'ja'],
      knowsAbout: [
        'iOS Development',
        'Swift',
        'Objective-C',
        'SwiftUI',
        'UIKit',
        'Core Data',
        'Node.js',
        'React Native',
        'Mobile Architecture',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${siteMetadata.siteUrl}/#website`,
      url: siteMetadata.siteUrl,
      name: `${siteMetadata.name} — ${siteMetadata.tagline}`,
      publisher: {
        '@id': `${siteMetadata.siteUrl}/#person`,
      },
      inLanguage: localeInfo.htmlLang,
    },
  ],
};
---

<!doctype html>
<html class="scroll-smooth" lang={localeInfo.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <!-- Google tag (gtag.js) -->
    <script
      is:inline
      async
      src={`https://www.googletagmanager.com/gtag/js?id=${siteMetadata.googleAnalyticsId}`}
    ></script>
    <script
      is:inline
      set:html={`window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', '${siteMetadata.googleAnalyticsId}');`}
    />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <meta content="web_standard" name="shell-type" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteMetadata.name} />
    <meta name="keywords" content={siteMetadata.keywords.join(', ')} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    {
      alternateLinks.map((alt) => (
        <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={defaultHref} />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteMetadata.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`${siteMetadata.name} — ${siteMetadata.tagline}`}
    />
    <meta property="og:locale" content={localeInfo.ogLocale} />
    {
      locales
        .filter((loc) => loc !== lang)
        .map((loc) => (
          <meta
            property="og:locale:alternate"
            content={localeConfigs[loc].ogLocale}
          />
        ))
    }

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- JSON-LD Structured Data -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    />
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Noto+Sans+TC:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="bg-background font-sans text-neutral-900 antialiased selection:bg-neutral-900 selection:text-white min-h-screen flex flex-col"
  >
    <Header activeNav={activeNav} lang={lang} />
    <main class="flex-1 w-full">
      <slot />
    </main>
    <Footer activeNav={activeNav} lang={lang} />

    <script>
      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement | null;
        if (!target) return;
        const gtagFn = (window as any).gtag as
          | ((...args: any[]) => void)
          | undefined;
        if (typeof gtagFn !== 'function') return;

        const resumeBtn = target.closest('#download-resume-btn');
        if (resumeBtn) {
          gtagFn('event', 'download_resume', {
            event_category: 'engagement',
            language: document.documentElement.lang,
          });
          return;
        }

        const link = target.closest('a') as HTMLAnchorElement | null;
        if (!link || !link.href) return;

        if (link.href.includes('apps.apple.com')) {
          gtagFn('event', 'app_store_click', {
            event_category: 'outbound',
            app_url: link.href,
            link_text: link.textContent?.trim() || '',
          });
        } else if (link.href.includes('linkedin.com')) {
          gtagFn('event', 'social_click', {
            event_category: 'outbound',
            platform: 'linkedin',
            link_url: link.href,
          });
        }
      });
    </script>
  </body>
</html>
