---
import type { OverviewWorkItem } from '../data/portfolio';

interface Props {
  project: OverviewWorkItem;
}

const { project } = Astro.props;
---

<article
  class="py-8 first:pt-0 last:pb-0 flex flex-col md:flex-row md:items-start justify-between gap-6 group"
>
  <div class="flex flex-col gap-2 max-w-xl">
    <div class="flex items-center gap-3">
      <img
        src={project.icon}
        alt={`${project.title} icon`}
        class="w-10 h-10 rounded-xl border border-neutral-200 shrink-0 object-cover"
        loading="lazy"
      />
      <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-3">
        <h3 class="text-lg font-medium text-neutral-900 tracking-tight">
          {
            project.href ? (
              <a
                class="hover:underline underline-offset-4 inline-flex items-center gap-1"
                href={project.href}
                rel="noopener noreferrer"
                target="_blank"
              >
                {project.title}
                <span class="material-symbols-outlined text-xs text-neutral-400">
                  arrow_outward
                </span>
              </a>
            ) : (
              <span class="inline-flex items-center gap-1">{project.title}</span>
            )
          }
        </h3>
        <span class="text-xs font-mono text-neutral-400">
          {project.subtitle}
        </span>
      </div>
    </div>
    <p class="text-sm text-neutral-600 leading-relaxed">
      {project.description}
    </p>
  </div>
  <div class="text-xs font-mono text-neutral-400 md:text-right shrink-0">
    {project.period}
  </div>
</article>
