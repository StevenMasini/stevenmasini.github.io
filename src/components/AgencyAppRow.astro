---
import type { AgencyProject } from '../data/portfolio';

interface Props {
  project: AgencyProject;
}

const { project } = Astro.props;
const isExternal = project.appStoreUrl
  ? project.appStoreUrl.startsWith('http')
  : false;
---

<div
  class="p-4 sm:p-5 flex flex-col sm:flex-row sm:items-start justify-between gap-3 sm:gap-6 hover:bg-neutral-50/60 transition-colors"
>
  <div class="sm:w-1/3 shrink-0">
    <div class="flex items-start gap-3">
      <img
        src={project.icon}
        alt={`${project.title} icon`}
        width="32"
        height="32"
        decoding="async"
        class="w-8 h-8 rounded-lg border border-neutral-200 shrink-0 object-cover mt-0.5"
        loading="lazy"
      />
      <div class="flex flex-col gap-0.5">
        <span class="font-medium text-sm text-neutral-950 leading-snug">
          {
            project.appStoreUrl ? (
              <a
                class="group/link inline-flex items-center gap-1"
                href={project.appStoreUrl}
                rel={isExternal ? 'noopener noreferrer' : undefined}
                target={isExternal ? '_blank' : undefined}
              >
                <span class="group-hover/link:underline underline-offset-4">
                  {project.title}
                </span>
                <span class="material-symbols-outlined text-xs text-neutral-400">
                  {isExternal ? 'arrow_outward' : 'arrow_forward'}
                </span>
              </a>
            ) : (
              project.title
            )
          }
        </span>
        <span class="text-xs font-mono text-neutral-400">
          {project.subtitle}
        </span>
        {
          project.ratingLabel && (
            <span class="text-[11px] font-mono text-neutral-500 pt-0.5">
              {project.ratingLabel}
            </span>
          )
        }
      </div>
    </div>
  </div>

  <div class="sm:flex-1 text-xs text-neutral-600 leading-relaxed">
    {project.description}
  </div>

  <div class="sm:w-44 shrink-0 flex flex-col sm:items-end gap-1 text-left sm:text-right text-xs font-mono">
    <span class="text-neutral-500">{project.techLabel}</span>
    {
      project.appStoreUrl && (
        <a
          class="inline-flex items-center gap-1 text-neutral-900 hover:text-neutral-600 transition-colors whitespace-nowrap"
          href={project.appStoreUrl}
          rel={isExternal ? 'noopener noreferrer' : undefined}
          target={isExternal ? '_blank' : undefined}
        >
          <span class="underline underline-offset-4">
            {project.appStoreLabel ?? 'View on App Store'}
          </span>
          <span class="material-symbols-outlined text-xs">
            {isExternal ? 'arrow_outward' : 'arrow_forward'}
          </span>
        </a>
      )
    }
  </div>
</div>
