---
import type { AgencyProject } from '../data/portfolio';

interface Props {
  project: AgencyProject;
}

const { project } = Astro.props;
---

<div
  class="p-4 sm:p-5 flex flex-col sm:flex-row sm:items-start justify-between gap-3 sm:gap-6 hover:bg-neutral-50/60 transition-colors"
>
  <div class="sm:w-1/3 shrink-0">
    <div class="flex items-start gap-3">
      <img
        src={project.icon}
        alt={`${project.title} icon`}
        width="32"
        height="32"
        decoding="async"
        class="w-8 h-8 rounded-lg border border-neutral-200 shrink-0 object-cover mt-0.5"
        loading="lazy"
      />
      <div class="flex flex-col gap-0.5">
        <span class="font-medium text-sm text-neutral-950 leading-snug">
          {project.title}
        </span>
        <span class="text-xs font-mono text-neutral-400">
          {project.subtitle}
        </span>
        {
          project.ratingLabel && (
            <span class="text-[11px] font-mono text-neutral-500 pt-0.5">
              {project.ratingLabel}
            </span>
          )
        }
      </div>
    </div>
  </div>

  <div class="sm:flex-1 text-xs text-neutral-600 leading-relaxed">
    {project.description}
  </div>

  <div class="sm:w-44 shrink-0 flex flex-col sm:items-end gap-1 text-left sm:text-right text-xs font-mono">
    <span class="text-neutral-500">{project.techLabel}</span>
    {
      project.appStoreUrl && (
        <a
          class="text-neutral-900 underline underline-offset-4 hover:text-neutral-600 transition-colors whitespace-nowrap"
          href={project.appStoreUrl}
          rel="noopener noreferrer"
          target="_blank"
        >
          {project.appStoreLabel ?? 'View on App Store →'}
        </a>
      )
    }
  </div>
</div>
