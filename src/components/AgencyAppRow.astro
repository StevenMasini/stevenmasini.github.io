---
import type { AgencyProject } from '../data/portfolio';

interface Props {
  project: AgencyProject;
}

const { project } = Astro.props;
---

<div
  class="p-4 sm:p-5 flex flex-col sm:flex-row sm:items-baseline justify-between gap-3 hover:bg-neutral-50/60 transition-colors"
>
  <div class="sm:w-1/3">
    <div class="flex items-center gap-3">
      <img
        src={project.icon}
        alt={`${project.title} icon`}
        width="32"
        height="32"
        decoding="async"
        class="w-8 h-8 rounded-lg border border-neutral-200 shrink-0 object-cover"
        loading="lazy"
      />
      <div>
        <span class="font-medium text-sm text-neutral-950 block">
          {project.title}
        </span>
        <span class="text-xs font-mono text-neutral-400">
          {project.subtitle}
        </span>
      </div>
    </div>
  </div>

  <div class="sm:w-1/2 text-xs text-neutral-600 leading-relaxed">
    {project.description}
  </div>

  <div class="sm:w-1/6 text-left sm:text-right text-xs font-mono text-neutral-500">
    {
      project.appStoreUrl ? (
        <a
          class="text-neutral-900 underline hover:text-neutral-600 transition-colors"
          href={project.appStoreUrl}
          rel="noopener noreferrer"
          target="_blank"
        >
          {project.techOrLinkLabel}
        </a>
      ) : (
        project.techOrLinkLabel
      )
    }
  </div>
</div>
