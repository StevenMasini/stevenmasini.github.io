---
import {
  defaultLocale,
  getLocalizedPath,
  getPortfolioData,
  type Locale,
  type NavItem,
} from '../data/portfolio';

interface Props {
  activeNav: NavItem['id'];
  lang?: Locale;
}

const { activeNav, lang = defaultLocale } = Astro.props;
const { siteMetadata, navItems } = getPortfolioData(lang);
const homeHref = getLocalizedPath(lang, '/');
---

<footer class="w-full bg-white border-t border-neutral-200/80 mt-16 print:hidden">
  <div class="max-w-6xl mx-auto px-4 sm:px-8 py-10 sm:py-12">
    <div
      class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6 pb-8 border-b border-neutral-100"
    >
      <a href={homeHref} class="flex items-center gap-3 group">
        <div
          class="w-7 h-7 rounded bg-neutral-900 text-white flex items-center justify-center font-mono font-medium text-xs shrink-0 group-hover:bg-neutral-800 transition-colors"
        >
          {siteMetadata.monogram}
        </div>
        <div class="flex flex-col sm:flex-row sm:items-center sm:gap-2">
          <span class="font-medium text-sm text-neutral-900 leading-tight">
            {siteMetadata.name}
          </span>
          <span class="hidden sm:inline text-xs text-neutral-400">—</span>
          <span class="text-xs text-neutral-500 leading-tight mt-0.5 sm:mt-0">
            {siteMetadata.tagline}
          </span>
        </div>
      </a>

      <nav class="flex flex-wrap items-center gap-x-6 gap-y-2" aria-label="Footer Navigation">
        {
          navItems.map((item) => {
            const isActive = item.id === activeNav;
            return (
              <a
                href={item.href}
                class:list={[
                  'text-xs transition-colors',
                  isActive
                    ? 'text-neutral-900 font-semibold'
                    : 'text-neutral-500 hover:text-neutral-900',
                ]}
              >
                {item.label}
              </a>
            );
          })
        }
      </nav>
    </div>

    <div
      class="pt-6 flex flex-col sm:flex-row items-start sm:items-baseline justify-between gap-2 sm:gap-4 text-xs font-mono text-neutral-400"
    >
      <p>© {siteMetadata.copyrightYear} {siteMetadata.name}</p>
      <p>{siteMetadata.timezoneLabel}</p>
    </div>
  </div>
</footer>
