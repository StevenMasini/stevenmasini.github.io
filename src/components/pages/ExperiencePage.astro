---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatsGrid from '../StatsGrid.astro';
import TimelineItem from '../TimelineItem.astro';
import {
  defaultLocale,
  getLocalizedPath,
  getPortfolioData,
  type Locale,
} from '../../data/portfolio';

interface Props {
  lang?: Locale;
}

const { lang = defaultLocale } = Astro.props;
const {
  siteMetadata,
  ui,
  experiencePageStats,
  experienceTimeline,
  educationList,
  technicalFocusList,
  languagesList,
} = getPortfolioData(lang);

const contactHref = getLocalizedPath(lang, '/contact');
---

<BaseLayout
  title={ui.experience.metaTitle}
  description={ui.experience.metaDescription}
  activeNav="experience"
  lang={lang}
>
  <div
    class="max-w-6xl mx-auto px-4 sm:px-8 py-12 md:py-16 print:py-0 print:px-0"
  >
    <!-- Header Section -->
    <section
      class="border-b border-neutral-200 pb-12 mb-12 print:pb-6 print:mb-8"
    >
      <div
        class="flex flex-col md:flex-row print:flex-row md:items-end print:items-end justify-between gap-6"
      >
        <div class="max-w-2xl">
          <div
            class="font-mono text-xs text-neutral-500 uppercase tracking-wider mb-2 print:hidden"
          >
            {ui.experience.eyebrow}
          </div>
          <div
            class="hidden print:block font-mono text-xs text-neutral-500 uppercase tracking-wider mb-1"
          >
            {siteMetadata.tagline}
          </div>
          <h1
            class="text-3xl sm:text-4xl font-semibold tracking-tight text-neutral-900 mb-3 print:hidden"
          >
            {ui.experience.title}
          </h1>
          <div
            class="hidden print:block text-3xl font-semibold tracking-tight text-neutral-900 mb-2"
          >
            {siteMetadata.name}
          </div>
          <p
            class="text-base print:text-xs text-neutral-600 leading-relaxed font-normal"
          >
            {ui.experience.description}
          </p>
        </div>

        <!-- Screen Only: Action Buttons -->
        <div
          class="flex flex-col sm:flex-row md:flex-col items-start md:items-end gap-2 shrink-0 print:hidden"
        >
          <button
            type="button"
            onclick="window.print()"
            class="inline-flex items-center gap-2 px-4 py-2 border border-neutral-200 bg-white hover:bg-neutral-50 rounded text-xs font-medium text-neutral-900 transition-colors cursor-pointer"
          >
            <span class="material-symbols-outlined text-base text-neutral-500">
              description
            </span>
            {ui.experience.downloadPdfBtn}
          </button>
          <a
            class="inline-flex items-center gap-1 font-mono text-xs text-neutral-500 hover:text-neutral-900 transition-colors underline"
            href={contactHref}
          >
            <span class="material-symbols-outlined text-[14px]">mail</span>
            {ui.experience.contactFormLink}
          </a>
        </div>

        <!-- Print Only: Contact Details -->
        <div
          class="hidden print:flex flex-col items-end gap-1 font-mono text-xs text-neutral-600 shrink-0"
        >
          <span class="font-medium text-neutral-900">stevenmasini.com</span>
          <span>{siteMetadata.linkedinDisplay}</span>
          <span>{siteMetadata.location}</span>
        </div>
      </div>

      <StatsGrid stats={experiencePageStats} variant="detailed" />
    </section>

    <!-- Content Grid: 8 Cols Experience, 4 Cols Education & Toolkit -->
    <div
      class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 print:gap-8 items-start"
    >
      <!-- Left: Chronological Resume Timeline -->
      <div class="lg:col-span-8 flex flex-col gap-10 print:gap-6">
        <div
          class="flex items-center justify-between border-b border-neutral-200 pb-3"
        >
          <h2
            class="text-sm font-semibold uppercase tracking-wider font-mono text-neutral-900"
          >
            {ui.experience.workHistoryTitle}
          </h2>
          <span class="font-mono text-xs text-neutral-500">
            {ui.experience.workHistoryPeriod}
          </span>
        </div>

        <div class="space-y-12 print:space-y-6">
          {experienceTimeline.map((item) => <TimelineItem item={item} />)}
        </div>
      </div>

      <!-- Right: Calm Education & Toolkit Sidebar -->
      <div class="lg:col-span-4 flex flex-col gap-10 print:gap-6">
        <!-- Education Section -->
        <section
          class="border-b border-neutral-200 pb-8 print:pb-6 space-y-6 print:space-y-4 print:break-inside-avoid"
        >
          <div class="flex items-center justify-between">
            <h2
              class="text-sm font-semibold uppercase tracking-wider font-mono text-neutral-900"
            >
              {ui.experience.educationTitle}
            </h2>
          </div>

          <div class="space-y-6 print:space-y-4">
            {
              educationList.map((edu, idx) => (
                <div
                  class:list={[
                    idx > 0 && 'pt-4 border-t border-neutral-200/60',
                  ]}
                >
                  <div class="flex items-baseline justify-between gap-2">
                    <h3 class="text-sm font-semibold text-neutral-900">
                      {edu.institution}
                    </h3>
                    <span class="text-xs font-mono text-neutral-500 shrink-0">
                      {edu.period}
                    </span>
                  </div>
                  <div class="text-xs text-neutral-600 font-medium mt-0.5">
                    {edu.subtitle}
                  </div>
                  {edu.degree && (
                    <div class="text-xs font-mono text-neutral-500 mt-1">
                      {edu.degree}
                    </div>
                  )}
                  <p class="text-xs text-neutral-600 mt-1.5 leading-relaxed">
                    {edu.description}
                  </p>
                </div>
              ))
            }

            <div class="pt-4 border-t border-neutral-200/60">
              <div class="text-xs font-medium text-neutral-900">
                {ui.experience.hackathonTitle}
              </div>
              <div class="text-xs font-mono text-neutral-500">
                {ui.experience.hackathonSubtitle}
              </div>
            </div>
          </div>
        </section>

        <!-- Technical Focus -->
        <section
          class="border-b border-neutral-200 pb-8 print:pb-6 space-y-4 print:break-inside-avoid"
        >
          <h2
            class="text-sm font-semibold uppercase tracking-wider font-mono text-neutral-900"
          >
            {ui.experience.technicalFocusTitle}
          </h2>
          <div class="space-y-4 text-xs">
            {
              technicalFocusList.map((focus) => (
                <div>
                  <div class="font-mono text-neutral-500 mb-1.5 uppercase text-[11px]">
                    {focus.category}
                  </div>
                  <div class="text-neutral-600 leading-relaxed">
                    {focus.skills}
                  </div>
                </div>
              ))
            }
          </div>
        </section>

        <!-- Languages Section -->
        <section
          class="border-b border-neutral-200 print:border-b-0 pb-8 print:pb-0 space-y-4 print:break-inside-avoid"
        >
          <h2
            class="text-sm font-semibold uppercase tracking-wider font-mono text-neutral-900"
          >
            {ui.experience.languagesTitle}
          </h2>
          <div class="space-y-2.5 text-xs">
            {
              languagesList.map((item, idx) => (
                <div
                  class:list={[
                    'flex flex-wrap items-baseline justify-between gap-x-3 gap-y-0.5 py-1.5',
                    idx < languagesList.length - 1 &&
                      'border-b border-neutral-200/60',
                  ]}
                >
                  <span class="font-medium text-neutral-900">
                    {item.language}
                  </span>
                  <span class="text-neutral-500 font-mono text-[11px]">
                    {item.proficiency}
                  </span>
                </div>
              ))
            }
          </div>
        </section>

        <!-- Direct Contact Note (Screen Only) -->
        <section
          class="p-5 border border-neutral-200 bg-white rounded space-y-2 print:hidden"
        >
          <div
            class="font-mono text-[11px] uppercase tracking-wider text-neutral-500"
          >
            {ui.experience.inquiriesTitle}
          </div>
          <div class="text-xs text-neutral-600 leading-relaxed">
            {ui.experience.inquiriesDescription}
          </div>
          <a
            class="inline-flex items-center gap-1 text-xs font-mono font-medium text-neutral-900 underline hover:text-black pt-1"
            href={contactHref}
          >
            {ui.experience.inquiriesLink}
          </a>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>

