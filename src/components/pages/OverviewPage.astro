---
import BaseLayout from '../../layouts/BaseLayout.astro';
import OverviewProjectItem from '../OverviewProjectItem.astro';
import {
  defaultLocale,
  getLocalizedPath,
  getPortfolioData,
  type Locale,
} from '../../data/portfolio';

interface Props {
  lang?: Locale;
}

const { lang = defaultLocale } = Astro.props;
const {
  siteMetadata,
  ui,
  overviewSelectedWork,
  overviewExperience,
} = getPortfolioData(lang);

const appsHref = getLocalizedPath(lang, '/apps-and-work');
const experienceHref = getLocalizedPath(lang, '/experience');
const contactHref = getLocalizedPath(lang, '/contact');
---

<BaseLayout
  title={ui.overview.metaTitle}
  description={ui.overview.metaDescription}
  activeNav="overview"
  lang={lang}
>
  <div
    class="mx-auto py-12 sm:py-16 md:py-20 flex flex-col gap-12 sm:gap-16 md:gap-20 max-w-6xl px-4 sm:px-8"
  >
    <!-- Hero / Quiet Introduction -->
    <section class="flex flex-col gap-6 max-w-2xl" id="about">
      <div class="flex flex-col gap-2">
        <h1
          class="text-3xl sm:text-4xl font-semibold tracking-tight text-neutral-900 leading-tight"
        >
          {siteMetadata.name}
        </h1>
        <p class="text-neutral-500 text-base sm:text-lg font-normal">
          {siteMetadata.tagline}
        </p>
      </div>
      <p class="text-neutral-700 text-base leading-relaxed">
        {ui.overview.heroBio}
      </p>
      <div class="flex items-center gap-5 text-sm pt-1">
        <a
          class="text-neutral-500 hover:text-neutral-900 transition-colors inline-flex items-center gap-1"
          href={siteMetadata.linkedinUrl}
          rel="noopener noreferrer"
          target="_blank"
        >
          LinkedIn
          <span class="material-symbols-outlined text-xs">arrow_outward</span>
        </a>
        <span class="text-neutral-300">/</span>
        <span class="text-neutral-500 text-xs font-mono">
          {siteMetadata.timezoneShort}
        </span>
      </div>
    </section>

    <div class="w-full border-t border-neutral-200/80"></div>

    <!-- Selected Works (Calm, Editorial List) -->
    <section class="flex flex-col gap-8" id="work">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h2 class="text-xs font-mono tracking-wider uppercase text-neutral-400">
          {ui.overview.selectedWorkTitle}
        </h2>
        <div class="flex items-center gap-4">
          <span class="text-xs text-neutral-400 font-mono">
            {ui.overview.selectedWorkPeriod}
          </span>
          <a
            href={appsHref}
            class="text-xs font-mono text-neutral-900 underline underline-offset-4 hover:text-neutral-600 transition-colors"
          >
            {ui.overview.allAppsLink}
          </a>
        </div>
      </div>

      <div class="flex flex-col divide-y divide-neutral-200/80">
        {
          overviewSelectedWork.map((project) => (
            <OverviewProjectItem project={project} />
          ))
        }
      </div>
    </section>

    <div class="w-full border-t border-neutral-200/80"></div>

    <!-- Background & Experience -->
    <section
      class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-start"
      id="experience"
    >
      <div class="md:col-span-4 flex flex-col gap-2">
        <h2 class="text-xs font-mono tracking-wider uppercase text-neutral-400">
          {ui.overview.backgroundTitle}
        </h2>
        <p class="text-sm text-neutral-600 leading-relaxed pt-2">
          {ui.overview.backgroundDescription}
        </p>
        <div class="pt-4 text-xs font-mono text-neutral-400 flex flex-col gap-1.5">
          <span>{ui.overview.languagesSummary}</span>
          <span>
            {ui.overview.locationPrefix} {siteMetadata.location}
          </span>
        </div>
        <div class="pt-3">
          <a
            href={experienceHref}
            class="text-xs font-mono text-neutral-900 underline underline-offset-4 hover:text-neutral-600 transition-colors"
          >
            {ui.overview.fullResumeLink}
          </a>
        </div>
      </div>

      <div class="md:col-span-8 flex flex-col divide-y divide-neutral-200/80">
        {
          overviewExperience.map((exp, idx) => (
            <div
              class:list={[
                'flex flex-col gap-1',
                idx === 0
                  ? 'pb-6'
                  : idx === overviewExperience.length - 1
                    ? 'pt-6'
                    : 'py-6',
              ]}
            >
              <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-0.5 sm:gap-4 text-sm">
                <span class="font-medium text-neutral-900">{exp.role}</span>
                <span class="text-xs font-mono text-neutral-400 shrink-0">
                  {exp.period}
                </span>
              </div>
              <span class="text-xs text-neutral-500">{exp.location}</span>
              <p class="text-xs text-neutral-600 mt-2 leading-relaxed">
                {exp.summary}
              </p>
            </div>
          ))
        }
      </div>
    </section>

    <div class="w-full border-t border-neutral-200/80"></div>

    <!-- Quiet Contact Footer Callout -->
    <section class="flex flex-col gap-4 py-2" id="contact">
      <div class="flex flex-col gap-2">
        <h2 class="text-lg font-medium text-neutral-900 tracking-tight">
          {ui.overview.contactTitle}
        </h2>
        <p class="text-sm text-neutral-600 leading-relaxed max-w-lg">
          {ui.overview.contactDescription}
        </p>
      </div>
      <div
        class="flex flex-col sm:flex-row items-start sm:items-center gap-4 pt-2"
      >
        <a
          class="inline-flex items-center gap-1.5 bg-neutral-900 text-white text-xs font-medium px-4 py-2 rounded hover:bg-neutral-800 transition-colors"
          href={contactHref}
        >
          {ui.overview.sendMessageBtn}
          <span class="material-symbols-outlined text-xs">arrow_outward</span>
        </a>
        <span class="text-neutral-400 text-xs">
          {ui.overview.orReachOutVia}
        </span>
        <a
          class="text-xs font-mono text-neutral-900 underline underline-offset-4 hover:text-neutral-600 inline-flex items-center gap-1"
          href={siteMetadata.linkedinUrl}
          rel="noopener noreferrer"
          target="_blank"
        >
          LinkedIn
          <span class="material-symbols-outlined text-xs">arrow_outward</span>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

