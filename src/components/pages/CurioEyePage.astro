---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPortfolioData } from '../../data/portfolio';
import { defaultLocale, type Locale } from '../../data/locales';
import { pagePath } from '../../data/pages';

interface Props {
  lang?: Locale;
}

const { lang = defaultLocale } = Astro.props;
const { ui } = getPortfolioData(lang);
const t = ui.curioEye;
const appsHref = pagePath('apps-and-work', lang);
---

<BaseLayout
  title={t.metaTitle}
  description={t.metaDescription}
  page="curio-eye"
  lang={lang}
>
  <!-- Subtle Top Return Bar -->
  <div class="w-full bg-neutral-100 border-b border-neutral-200">
    <div
      class="max-w-6xl mx-auto px-4 sm:px-8 py-2.5 flex flex-wrap items-center justify-between gap-2 text-xs font-mono"
    >
      <a
        href={appsHref}
        class="group/link inline-flex items-center gap-1 text-neutral-700 hover:text-neutral-950 font-medium transition-colors"
      >
        <span class="material-symbols-outlined text-xs">arrow_back</span>
        <span class="group-hover/link:underline underline-offset-4">
          {t.backLink}
        </span>
      </a>
      <div class="flex flex-wrap items-center gap-2 text-neutral-500">
        <span
          class="px-2 py-0.5 bg-white border border-neutral-200 rounded text-[12px] text-neutral-700"
        >
          {t.badge}
        </span>
        <span class="hidden sm:inline text-[12px]">{t.note}</span>
      </div>
    </div>
  </div>

  <!-- Full-Width Responsive Infographic -->
  <div class="w-full bg-white">
    <picture class="block w-full">
      <source srcset="/images/curioeye/infographic.webp" type="image/webp" />
      <img
        src="/images/curioeye/infographic.jpg"
        alt={t.infographicAlt}
        width="1920"
        height="13553"
        decoding="async"
        class="w-full h-auto block"
      />
    </picture>
  </div>
</BaseLayout>

