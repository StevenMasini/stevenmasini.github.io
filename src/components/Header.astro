---
import {
  defaultLocale,
  getLocalizedPath,
  getPortfolioData,
  localeConfigs,
  locales,
  type Locale,
  type NavItem,
} from '../data/portfolio';

interface Props {
  activeNav: NavItem['id'];
  lang?: Locale;
}

const { activeNav, lang = defaultLocale } = Astro.props;
const data = getPortfolioData(lang);
const { siteMetadata, navItems, ui, localeInfo } = data;

const pageSlugMap: Record<NavItem['id'], string> = {
  overview: '/',
  'apps-and-work': '/apps-and-work',
  experience: '/experience',
  contact: '/contact',
};

const rawPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const currentSlug =
  rawPath.replace(/^\/(fr|zh-tw)(?=\/|$)/, '') || pageSlugMap[activeNav] || '/';
const homeHref = getLocalizedPath(lang, '/');
const contactHref = getLocalizedPath(lang, '/contact');
---

<header
  class="sticky top-0 z-50 w-full bg-white/85 backdrop-blur-md border-b border-neutral-200/80 print:hidden"
>
  <div
    class="max-w-6xl mx-auto px-4 sm:px-8 h-16 flex items-center justify-between gap-3"
  >
    <!-- Brand Identity -->
    <div class="flex items-center min-w-0">
      <a class="flex items-center gap-2.5 sm:gap-3 group min-w-0" href={homeHref}>
        <div
          class="w-8 h-8 rounded-md bg-neutral-900 text-white font-mono font-medium text-xs flex items-center justify-center tracking-wider shrink-0 group-hover:bg-neutral-800 transition-colors"
        >
          {siteMetadata.monogram}
        </div>
        <div class="flex flex-col min-w-0">
          <span
            class="font-semibold tracking-tight text-neutral-900 text-sm leading-tight group-hover:text-black truncate"
          >
            {siteMetadata.name}
          </span>
          <span
            class="text-[10px] sm:text-[11px] text-neutral-500 font-mono leading-tight mt-0.5 truncate"
          >
            {siteMetadata.tagline}
          </span>
        </div>
      </a>
    </div>

    <!-- Desktop Navigation -->
    <nav
      class="hidden md:flex items-center gap-1 shrink-0"
      aria-label="Primary Navigation"
    >
      {
        navItems.map((item) => {
          const isActive = item.id === activeNav;
          return (
            <a
              href={item.href}
              aria-current={isActive ? 'page' : undefined}
              class:list={[
                'text-xs px-3 py-1.5 rounded transition-colors',
                isActive
                  ? 'font-semibold text-neutral-900 bg-neutral-100'
                  : 'font-medium text-neutral-600 hover:text-neutral-900 hover:bg-neutral-100/70',
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <!-- Language Selector + CTA + Mobile Menu Toggle -->
    <div class="flex items-center gap-2 sm:gap-2.5 shrink-0">
      <!-- Language Selection Button (Left of "Get in touch") -->
      <div class="relative" id="lang-dropdown-container">
        <button
          type="button"
          id="lang-menu-btn"
          aria-label={ui.header.languageLabel}
          aria-expanded="false"
          aria-haspopup="true"
          class="inline-flex items-center gap-1.5 border border-neutral-200 bg-white hover:bg-neutral-50 hover:border-neutral-300 text-neutral-700 hover:text-neutral-900 text-xs font-mono font-medium px-2.5 py-1.5 rounded-md transition-colors cursor-pointer"
        >
          <span class="material-symbols-outlined text-[15px] text-neutral-500">
            language
          </span>
          <span>{localeInfo.shortLabel}</span>
          <span
            class="material-symbols-outlined text-[15px] text-neutral-400 transition-transform duration-150"
            id="lang-menu-chevron"
          >
            expand_more
          </span>
        </button>

        <div
          id="lang-dropdown-menu"
          role="menu"
          aria-orientation="vertical"
          class="hidden absolute right-0 mt-1.5 w-40 bg-white border border-neutral-200 rounded-md shadow-md py-1 z-50"
        >
          {
            locales.map((targetLocale) => {
              const info = localeConfigs[targetLocale];
              const isCurrent = targetLocale === lang;
              const targetHref = getLocalizedPath(targetLocale, currentSlug);
              return (
                <a
                  href={targetHref}
                  data-locale={targetLocale}
                  role="menuitem"
                  aria-current={isCurrent ? 'true' : undefined}
                  class:list={[
                    'flex items-center justify-between px-3 py-1.5 text-xs transition-colors',
                    isCurrent
                      ? 'bg-neutral-100/80 text-neutral-900 font-semibold'
                      : 'text-neutral-600 hover:bg-neutral-50 hover:text-neutral-900',
                  ]}
                >
                  <span>{info.label}</span>
                  <span class="font-mono text-[10px] text-neutral-400">
                    {info.shortLabel}
                  </span>
                </a>
              );
            })
          }
        </div>
      </div>

      <a
        href={contactHref}
        class="hidden sm:inline-flex items-center gap-1.5 bg-neutral-900 hover:bg-neutral-800 text-white text-xs font-medium px-3.5 py-1.5 rounded-md transition-colors shadow-sm"
      >
        {ui.header.getInTouch}
      </a>

      <button
        type="button"
        id="mobile-menu-btn"
        aria-label={ui.header.toggleMenuLabel}
        aria-expanded="false"
        class="md:hidden inline-flex items-center justify-center p-2 rounded-md text-neutral-700 hover:text-neutral-900 hover:bg-neutral-100 transition-colors"
      >
        <span class="material-symbols-outlined text-xl" id="mobile-menu-icon">
          menu
        </span>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-neutral-200/80 bg-white px-4 py-4 space-y-3 shadow-sm"
  >
    <div class="flex flex-col space-y-1">
      {
        navItems.map((item) => {
          const isActive = item.id === activeNav;
          return (
            <a
              href={item.href}
              aria-current={isActive ? 'page' : undefined}
              class:list={[
                'text-sm px-3 py-2.5 rounded-md transition-colors',
                isActive
                  ? 'font-semibold text-neutral-900 bg-neutral-100'
                  : 'font-normal text-neutral-600 hover:text-neutral-900 hover:bg-neutral-50',
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
    </div>
    <div class="pt-2 border-t border-neutral-100 sm:hidden">
      <a
        href={contactHref}
        class="w-full inline-flex items-center justify-center gap-1.5 bg-neutral-900 hover:bg-neutral-800 text-white text-xs font-medium px-4 py-2.5 rounded-md transition-colors shadow-sm"
      >
        {ui.header.getInTouch}
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const icon = document.getElementById('mobile-menu-icon');

  btn?.addEventListener('click', () => {
    const isExpanded = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!isExpanded));
    menu?.classList.toggle('hidden');
    if (icon) {
      icon.textContent = isExpanded ? 'menu' : 'close';
    }
  });

  // Language dropdown toggle
  const langContainer = document.getElementById('lang-dropdown-container');
  const langBtn = document.getElementById('lang-menu-btn');
  const langMenu = document.getElementById('lang-dropdown-menu');
  const langChevron = document.getElementById('lang-menu-chevron');

  function closeLangMenu() {
    langBtn?.setAttribute('aria-expanded', 'false');
    langMenu?.classList.add('hidden');
    langChevron?.classList.remove('rotate-180');
  }

  langBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isExpanded = langBtn.getAttribute('aria-expanded') === 'true';
    langBtn.setAttribute('aria-expanded', String(!isExpanded));
    langMenu?.classList.toggle('hidden');
    langChevron?.classList.toggle('rotate-180', !isExpanded);
  });

  document.addEventListener('click', (e) => {
    if (langContainer && !langContainer.contains(e.target as Node)) {
      closeLangMenu();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeLangMenu();
    }
  });

  // Save language choice & track GA4 language_switch event
  const langLinks = langMenu?.querySelectorAll('a[data-locale]');
  langLinks?.forEach((link) => {
    link.addEventListener('click', () => {
      const selectedLocale = link.getAttribute('data-locale');
      if (selectedLocale) {
        try {
          localStorage.setItem('preferred_locale', selectedLocale);
        } catch {
          // Ignore storage errors
        }
        const gtagFn = (window as any).gtag as
          | ((...args: any[]) => void)
          | undefined;
        if (typeof gtagFn === 'function') {
          gtagFn('event', 'language_switch', {
            target_language: selectedLocale,
          });
        }
      }
    });
  });

  // Respect saved language preference on direct root visit
  try {
    const savedLocale = localStorage.getItem('preferred_locale');
    const isDirectRootVisit =
      window.location.pathname === '/' &&
      (!document.referrer || !document.referrer.includes(window.location.host));
    if (
      isDirectRootVisit &&
      (savedLocale === 'fr' || savedLocale === 'zh-tw')
    ) {
      window.location.replace(`/${savedLocale}`);
    }
  } catch {
    // Ignore storage errors
  }
</script>
