---
import type { SpotlightProject } from '../data/portfolio';

interface Props {
  project: SpotlightProject;
}

const { project } = Astro.props;
const isExternal = project.appStoreUrl
  ? project.appStoreUrl.startsWith('http')
  : false;
---

<div
  class="flex flex-col justify-between gap-4 p-6 bg-white border border-neutral-200 rounded"
>
  <div class="flex flex-col gap-3">
    <div
      class="flex flex-wrap items-center justify-between gap-2 text-xs font-mono text-neutral-500"
    >
      <span>{project.category}</span>
      <span>{project.period}</span>
    </div>

    <div class="flex items-center gap-3">
      <img
        src={project.icon}
        alt={`${project.title} icon`}
        width="40"
        height="40"
        decoding="async"
        class="w-10 h-10 rounded-lg border border-neutral-200 shadow-sm shrink-0 object-cover"
        loading="lazy"
      />
      <h4 class="text-xl font-semibold text-neutral-950">
        {
          project.appStoreUrl ? (
            <a
              class="hover:underline underline-offset-4 inline-flex items-center gap-1.5"
              href={project.appStoreUrl}
              rel={isExternal ? 'noopener noreferrer' : undefined}
              target={isExternal ? '_blank' : undefined}
            >
              {project.title}
              <span class="material-symbols-outlined text-xs text-neutral-400">
                {isExternal ? 'arrow_outward' : 'arrow_forward'}
              </span>
            </a>
          ) : (
            project.title
          )
        }
      </h4>
    </div>

    <p class="text-xs text-neutral-600 leading-relaxed">
      {project.summary}
    </p>

    <ul class="text-xs text-neutral-600 space-y-2 mt-2 font-mono">
      {
        project.bullets.map((bullet) => (
          <li class="flex items-start gap-2">
            <span class="text-neutral-900 font-bold">•</span>
            <span>{bullet}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <div
    class="pt-4 border-t border-neutral-100 flex items-end justify-between gap-4 text-xs font-mono text-neutral-400"
  >
    <div class="flex flex-col gap-0.5">
      <span>{project.company}</span>
      {
        project.ratingLabel && (
          <span class="text-neutral-500">{project.ratingLabel}</span>
        )
      }
    </div>
    {
      project.appStoreUrl ? (
        <a
          class="text-neutral-900 underline underline-offset-4 hover:text-neutral-600 font-mono transition-colors whitespace-nowrap shrink-0"
          href={project.appStoreUrl}
          rel={isExternal ? 'noopener noreferrer' : undefined}
          target={isExternal ? '_blank' : undefined}
        >
          {project.locationOrLinkText}
        </a>
      ) : (
        <span class="shrink-0">{project.locationOrLinkText}</span>
      )
    }
  </div>
</div>
