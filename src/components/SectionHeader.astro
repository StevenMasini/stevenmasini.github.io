---
interface Props {
  title: string;
  rightLabel?: string;
  bordered?: boolean;
}

const { title, rightLabel, bordered = true } = Astro.props;
---

<div
  class:list={[
    'flex items-baseline justify-between',
    bordered && 'border-b border-neutral-200 pb-3',
  ]}
>
  <h2 class="text-xs font-mono uppercase tracking-widest text-neutral-500 font-medium">
    {title}
  </h2>
  {rightLabel && <span class="text-xs font-mono text-neutral-400">{rightLabel}</span>}
</div>
