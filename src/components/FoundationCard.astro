---
import type { EarlyFoundation } from '../data/portfolio';

interface Props {
  item: EarlyFoundation;
}

const { item } = Astro.props;
---

<div
  class="p-4 bg-white border border-neutral-200 rounded flex flex-col justify-between gap-2"
>
  <div>
    <span class="text-xs font-mono text-neutral-400 block mb-1">
      {item.category}
    </span>
    <span class="font-medium text-sm text-neutral-900 block">
      {item.title}
    </span>
    <p class="text-xs text-neutral-600 mt-1">
      {item.description}
    </p>
  </div>
  <span class="text-[11px] font-mono text-neutral-400 mt-2">
    {item.stack}
  </span>
</div>
