---
import type { FlagshipProject } from '../data/portfolio';
import Badge from './Badge.astro';

interface Props {
  project: FlagshipProject;
}

const { project } = Astro.props;
const isExternal = project.appStoreUrl
  ? project.appStoreUrl.startsWith('http')
  : false;
---

<article
  class="flex flex-col lg:flex-row gap-8 lg:gap-14 pb-14 border-b border-neutral-200"
>
  <div class="lg:w-1/3 flex flex-col gap-3 shrink-0">
    <div class="flex items-center gap-2">
      <Badge label={project.period} variant="muted" />
      <span class="text-xs font-mono text-neutral-400">{project.roleType}</span>
    </div>
    <div class="flex items-center gap-3.5">
      <img
        src={project.icon}
        alt={`${project.title} icon`}
        width="48"
        height="48"
        decoding="async"
        class="w-12 h-12 rounded-xl border border-neutral-200 shadow-sm shrink-0 object-cover"
        loading="lazy"
      />
      <h3 class="text-2xl font-semibold text-neutral-950 tracking-tight">
        {
          project.appStoreUrl ? (
            <a
              class="group/link inline-flex items-center gap-1.5"
              href={project.appStoreUrl}
              rel={isExternal ? 'noopener noreferrer' : undefined}
              target={isExternal ? '_blank' : undefined}
            >
              <span class="group-hover/link:underline underline-offset-4">
                {project.title}
              </span>
              <span class="material-symbols-outlined text-xs text-neutral-400">
                {isExternal ? 'arrow_outward' : 'arrow_forward'}
              </span>
            </a>
          ) : (
            project.title
          )
        }
      </h3>
    </div>
    <p class="text-sm text-neutral-600 leading-normal">
      {project.summary}
    </p>
    <div class="flex flex-wrap gap-1.5 pt-2">
      {project.tags.map((tag) => <Badge label={tag} />)}
    </div>
  </div>

  <div class="lg:w-2/3 flex flex-col justify-between gap-6">
    <div class="space-y-4 text-sm text-neutral-700 leading-relaxed">
      {
        project.highlights.map((item, idx) => (
          <div
            class:list={[
              idx < project.highlights.length - 1 &&
                'pb-3 border-b border-neutral-100',
            ]}
          >
            <span class="font-medium text-neutral-900 block mb-1">
              {item.title}
            </span>
            <p class="text-neutral-600 text-xs sm:text-sm">
              {item.description}
            </p>
          </div>
        ))
      }
    </div>

    <div
      class="pt-2 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs font-mono text-neutral-500"
    >
      <span>{project.footerNote}</span>
      {
        project.appStoreUrl && (
          <a
            class="inline-flex items-center gap-1 text-neutral-900 hover:text-neutral-600 transition-colors whitespace-nowrap shrink-0"
            href={project.appStoreUrl}
            rel={isExternal ? 'noopener noreferrer' : undefined}
            target={isExternal ? '_blank' : undefined}
          >
            <span class="underline underline-offset-4">
              {project.appStoreLabel ?? 'View on App Store'}
            </span>
            <span class="material-symbols-outlined text-xs">
              {isExternal ? 'arrow_outward' : 'arrow_forward'}
            </span>
          </a>
        )
      }
    </div>
  </div>
</article>
